ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://en_learning:replace-me@127.0.0.1:5432/en_learning
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://127.0.0.1:6379/0

SECRET_KEY=replace-me
JWT_ACCESS_TTL_SECONDS=300
JWT_REFRESH_TTL_SECONDS=604800

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=avatar
AVATAR_MAX_BYTES=5242880

TRACKER_MAX_BODY_BYTES=65536
TRACKER_RATE_LIMIT=120
TRACKER_RATE_WINDOW_SECONDS=60

ALIPAY_APP_ID=replace-me
ALIPAY_SELLER_ID=replace-me
ALIPAY_PRIVATE_KEY=replace-me
ALIPAY_PUBLIC_KEY=replace-me
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=https://example.com
PAYMENT_EXPIRATION_SECONDS=300
PAYMENT_NOTIFY_MAX_BYTES=65536

SOCKET_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SOCKET_REDIS_CHANNEL=en-learning:socketio

EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_STARTTLS=false
EMAIL_USER=replace-me
EMAIL_PASSWORD=replace-me
EMAIL_FROM=replace-me@example.com
DIGEST_TIMEZONE=Asia/Shanghai
WORKER_JOB_TIMEOUT_SECONDS=30
WORKER_JOB_LOCK_SECONDS=60
WORKER_JOB_MAX_ATTEMPTS=4
WORKER_RETRY_DELAY_SECONDS=5

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Configure both values to enable webSearch=true.
# BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
# BOCHA_API_KEY=replace-me

LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
AI_MAX_INPUT_CHARACTERS=4000
AI_HISTORY_MESSAGE_LIMIT=40
AI_SSE_HEARTBEAT_SECONDS=10
AI_CONVERSATION_LOCK_TTL_SECONDS=150
AI_SEARCH_RESULT_LIMIT=5
AI_SEARCH_CONTEXT_CHARACTERS=8000

HTTP_TIMEOUT_SECONDS=10
HEALTH_CHECK_TIMEOUT_SECONDS=2
